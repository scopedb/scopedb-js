{
  "name": "scopedb",
  "version": "0.2.2",
  "description": "The official server-side JavaScript client for ScopeDB, with TypeScript support",
  "keywords": [
    "scopedb",
    "scopeql",
    "database",
    "analytics",
    "sdk",
    "javascript",
    "typescript",
    "nodejs",
    "nextjs",
    "bun",
    "serverless"
  ],
  "homepage": "https://www.scopedb.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scopedb/scopedb-js.git"
  },
  "bugs": {
    "url": "https://github.com/scopedb/scopedb-js/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "examples/**/*.ts",
    "examples/README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm run clean:dist && tsc -p tsconfig.json",
    "build:examples": "pnpm run build && pnpm run clean:examples && tsc -p tsconfig.examples.json",
    "check": "pnpm run build && pnpm run check:examples:built",
    "check:examples": "pnpm run build && pnpm run check:examples:built",
    "check:examples:built": "tsc -p tsconfig.examples.json --noEmit && pnpm run check:package",
    "check:package": "node scripts/check-package.mjs",
    "smoke:runtime": "pnpm run build && node scripts/smoke-runtime.mjs",
    "smoke:web-runtime": "pnpm run build && node scripts/smoke-runtime.mjs --without-buffer",
    "clean:dist": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "clean:examples": "node -e \"require('node:fs').rmSync('dist-test/examples-build', { recursive: true, force: true })\"",
    "example": "pnpm run build:examples && node scripts/run-example.mjs",
    "example:list": "node scripts/run-example.mjs --list",
    "example:append": "pnpm run example -- append",
    "example:append-stream": "pnpm run example -- append-stream",
    "example:append-bulk": "pnpm run example -- append-bulk",
    "example:append-telemetry": "pnpm run example -- append-telemetry",
    "example:catalog": "pnpm run example -- catalog",
    "example:append-transform": "pnpm run example -- append-transform",
    "example:statement": "pnpm run example -- statement",
    "prepack": "pnpm run test && pnpm run check",
    "test": "tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.test.json && node --test dist-test/tests/*.test.js",
    "test:integration": "tsc -p tsconfig.test.json && node --test dist-test/tests/native-06.test.js"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@10.32.1"
}
